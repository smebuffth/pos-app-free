# Environment contract for Nisia POS. Copy to .env.local (for `npm run dev`) and to .dev.vars (for `npm run cf:preview`).
# Fill the values for each environment separately. Never commit real values; this file holds placeholders only.

APP_URL=http://localhost:3000

# Written by scripts/db-up.sh (local PostgreSQL in Docker). A hosted development database is written by
# scripts/db-set-url.sh, run by you. Production uses a DATABASE_URL secret: wrangler secret put DATABASE_URL.
DATABASE_URL=

# Secret for the daily job. Generate with: openssl rand -hex 24
CRON_SECRET=

# Encrypts the owner's AI key at rest. 32 random bytes, base64. Generate with: openssl rand -base64 32
# Keep a copy: losing it makes the saved AI key unreadable.
APP_ENCRYPTION_KEY=

# Optional. Extra hostnames that browser-based MCP clients may call from, comma-separated.
MCP_ALLOWED_ORIGINS=

# Optional. Hostnames of a named Cloudflare Tunnel, comma-separated, no https:// and no port
# (e.g. pos-dev.example.com). Quick tunnels (*.trycloudflare.com) are allowed without it. Read by next.config.ts at
# startup, so restart `npm run dev` after changing it. See README.md, "Cloudflare Tunnel".
TUNNEL_HOSTNAMES=
