{
  "name": "nisia-pos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate:local": "node --env-file=.dev.vars scripts/migrate.mjs",
    "db:migrate:remote": "node --env-file=.env.remote scripts/migrate.mjs",
    "cf:build": "node scripts/cloudflare-build.mjs",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare populateCache local && wrangler dev --port 8787",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare populateCache remote && wrangler deploy",
    "check:pos": "tsx scripts/pos-check.mts",
    "check:mcp": "tsx scripts/mcp-check.mts",
    "tunnel": "cloudflared tunnel --url http://localhost:3000",
    "tunnel:named": "cloudflared tunnel --config cloudflared/config.yml run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@google/genai": "2.27.0",
    "@modelcontextprotocol/server": "2.3.1",
    "@opennextjs/cloudflare": "1.20.9",
    "@types/pg": "8.23.1",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "framer-motion": "14.0.0",
    "lucide-react": "1.52.0",
    "next": "16.4.3",
    "openai": "7.30.0",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "wrangler": "4.148.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "shadcn": "4.21.3",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  }
}
